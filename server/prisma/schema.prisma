generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Partido {
  id            Int       @id @default(autoincrement())
  etapa         String    @default("Fase de Grupos")
  inicio        DateTime  @default(now())
  finalizado    Boolean   @default(false)
  activo        Boolean   @default(false)
  equipoGanador String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  equipo1       Equipo    @relation("Equipo1", fields: [equipo1Id], references: [id])
  equipo2       Equipo    @relation("Equipo2", fields: [equipo2Id], references: [id])
  equipo1Id     Int
  equipo2Id     Int

  configuracion  ConfiguracionPartido?
  estado         EstadoPartido?
  historial      HistorialAccion[]
}

model Equipo {
  id       Int    @id @default(autoincrement())
  jugador1 String @default("")
  jugador2 String @default("")
  color    String @default("#17A2B8")

  partidosComoEq1 Partido[] @relation("Equipo1")
  partidosComoEq2 Partido[] @relation("Equipo2")
}

model ConfiguracionPartido {
  id                  Int     @id @default(autoincrement())
  partidoId           Int     @unique
  partido             Partido @relation(fields: [partidoId], references: [id], onDelete: Cascade)

  cantidadSets        Int     @default(3)
  gamesPorSet         Int     @default(6)
  puntoOro            Boolean @default(false)
  ultimoPuntoTieBreak Int     @default(100)
  ultimoSetTieBreak   Boolean @default(false)
  ultimoGameSuperTB   Int     @default(100)
}

model EstadoPartido {
  id               Int      @id @default(autoincrement())
  partidoId        Int      @unique
  partido          Partido  @relation(fields: [partidoId], references: [id], onDelete: Cascade)

  gameEquipo1      Int      @default(0)
  gameEquipo2      Int      @default(0)
  setsJSON         String   @default("[[0,0],[0,0],[0,0]]")
  setActual        Int      @default(1)
  ultimoPunto      Int      @default(4)
  ultimoGame       Int      @default(6)
  servicioActual   Int      @default(0)
  ordenServicios   String   @default("[0,2,1,3]")
  posicionServicio Int      @default(0)
  tiebreak         Boolean  @default(false)

  calentamientoActivo Boolean @default(false)
  calentamientoFin    BigInt  @default(0)
  descansoActivo      Boolean @default(false)
  descansoSegundos    Int     @default(0)
  descansoFin         BigInt  @default(0)

  pantallaActual String @default("")
  tiempoFinalMs  BigInt  @default(0)

  updatedAt DateTime @updatedAt
}

model HistorialAccion {
  id         Int      @id @default(autoincrement())
  partidoId  Int
  partido    Partido  @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  estadoJSON String
  timestamp  DateTime @default(now())
}
