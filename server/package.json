{
  "name": "torneo-smaash-server",
  "version": "1.0.0",
  "description": "Backend para Torneo Smaash - Express + Prisma + SQLite",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:prod": "node src/server.js --prod",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma db push && prisma generate",
    "prisma:studio": "prisma studio",
    "seed": "node src/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
